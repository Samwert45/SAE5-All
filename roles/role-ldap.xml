<role xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      xmlns:c="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      xmlns:icfs="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/resource-schema-3"
      xmlns:ri="http://midpoint.evolveum.com/xml/ns/public/resource/instance-3">
    <name>ldap</name>
    <description>Role LDAP - Provisionne avec groupe LDAP</description>

    <inducement>
        <construction>
            <resourceRef oid="736ea741-2c73-4478-b5d1-07d84cdf860f" type="c:ResourceType"/>
            <kind>account</kind>
            <intent>default</intent>

            <!-- Username -->
            <attribute>
                <ref>icfs:name</ref>
                <outbound>
                    <strength>strong</strength>
                    <source>
                        <path>$focus/name</path>
                    </source>
                </outbound>
            </attribute>

            <!-- Description -->
            <attribute>
                <ref>ri:description</ref>
                <outbound>
                    <strength>strong</strength>
                    <source>
                        <path>$focus/description</path>
                    </source>
                </outbound>
            </attribute>

            <!-- Nom complet -->
            <attribute>
                <ref>ri:fullName</ref>
                <outbound>
                    <strength>strong</strength>
                    <source>
                        <path>$focus/fullName</path>
                    </source>
                </outbound>
            </attribute>

            <!-- Prenom -->
            <attribute>
                <ref>ri:firstName</ref>
                <outbound>
                    <strength>strong</strength>
                    <source>
                        <path>$focus/givenName</path>
                    </source>
                </outbound>
            </attribute>

            <!-- Nom de famille -->
            <attribute>
                <ref>ri:lastName</ref>
                <outbound>
                    <strength>strong</strength>
                    <source>
                        <path>$focus/familyName</path>
                    </source>
                </outbound>
            </attribute>

            <!-- Nom supplementaire -->
            <attribute>
                <ref>ri:additionalName</ref>
                <outbound>
                    <strength>strong</strength>
                    <source>
                        <path>$focus/additionalName</path>
                    </source>
                </outbound>
            </attribute>

            <!-- Surnom -->
            <attribute>
                <ref>ri:nickname</ref>
                <outbound>
                    <strength>strong</strength>
                    <source>
                        <path>$focus/nickName</path>
                    </source>
                </outbound>
            </attribute>

            <!-- Prefixe honorifique -->
            <attribute>
                <ref>ri:honorificPrefix</ref>
                <outbound>
                    <strength>strong</strength>
                    <source>
                        <path>$focus/honorificPrefix</path>
                    </source>
                </outbound>
            </attribute>

            <!-- Suffixe honorifique -->
            <attribute>
                <ref>ri:honorificSuffix</ref>
                <outbound>
                    <strength>strong</strength>
                    <source>
                        <path>$focus/honorificSuffix</path>
                    </source>
                </outbound>
            </attribute>

            <!-- Titre -->
            <attribute>
                <ref>ri:title</ref>
                <outbound>
                    <strength>strong</strength>
                    <source>
                        <path>$focus/title</path>
                    </source>
                </outbound>
            </attribute>

            <!-- Langue preferee -->
            <attribute>
                <ref>ri:preferredLanguage</ref>
                <outbound>
                    <strength>strong</strength>
                    <source>
                        <path>$focus/preferredLanguage</path>
                    </source>
                </outbound>
            </attribute>

            <!-- Region -->
            <attribute>
                <ref>ri:locale</ref>
                <outbound>
                    <strength>strong</strength>
                    <source>
                        <path>$focus/locale</path>
                    </source>
                </outbound>
            </attribute>

            <!-- Fuseau horaire -->
            <attribute>
                <ref>ri:timezone</ref>
                <outbound>
                    <strength>strong</strength>
                    <source>
                        <path>$focus/timezone</path>
                    </source>
                </outbound>
            </attribute>

            <!-- Email -->
            <attribute>
                <ref>ri:email</ref>
                <outbound>
                    <strength>strong</strength>
                    <source>
                        <path>$focus/emailAddress</path>
                    </source>
                </outbound>
            </attribute>

            <!-- Telephone -->
            <attribute>
                <ref>ri:telephoneNumber</ref>
                <outbound>
                    <strength>strong</strength>
                    <source>
                        <path>$focus/telephoneNumber</path>
                    </source>
                </outbound>
            </attribute>

            <!-- Personal Number -->
            <attribute>
                <ref>ri:personalNumber</ref>
                <outbound>
                    <strength>strong</strength>
                    <source>
                        <path>$focus/personalNumber</path>
                    </source>
                </outbound>
            </attribute>

            <!-- Centre de couts -->
            <attribute>
                <ref>ri:costCenter</ref>
                <outbound>
                    <strength>strong</strength>
                    <source>
                        <path>$focus/costCenter</path>
                    </source>
                </outbound>
            </attribute>

            <!-- Organisation -->
            <attribute>
                <ref>ri:organization</ref>
                <outbound>
                    <strength>strong</strength>
                    <expression>
                        <script>
                            <code>
                                focus?.organization?.size() > 0 ? focus.organization[0]?.orig : null
                            </code>
                        </script>
                    </expression>
                </outbound>
            </attribute>

            <!-- Unite organisationnelle -->
            <attribute>
                <ref>ri:organizationalUnit</ref>
                <outbound>
                    <strength>strong</strength>
                    <expression>
                        <script>
                            <code>
                                focus?.organizationalUnit?.size() > 0 ? focus.organizationalUnit[0]?.orig : null
                            </code>
                        </script>
                    </expression>
                </outbound>
            </attribute>

            <!-- Localite -->
            <attribute>
                <ref>ri:locality</ref>
                <outbound>
                    <strength>strong</strength>
                    <source>
                        <path>$focus/locality</path>
                    </source>
                </outbound>
            </attribute>

            <!-- Nom du role -->
            <attribute>
                <ref>ri:roles</ref>
                <outbound>
                    <strength>strong</strength>
                    <expression>
                        <value>ldap</value>
                    </expression>
                </outbound>
            </attribute>

            <!-- Groupe LDAP - SPECIFIQUE A CE ROLE -->
            <attribute>
                <ref>ri:ldapGroups</ref>
                <outbound>
                    <strength>strong</strength>
                    <expression>
                        <value>cn=LDAP-Users,ou=Groups,dc=example,dc=com</value>
                    </expression>
                </outbound>
            </attribute>

        </construction>
    </inducement>
</role>
